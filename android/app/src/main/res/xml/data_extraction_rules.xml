<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules: token sesi & log bridge QRIS TIDAK boleh ikut cloud backup.
    Senyap-senyap menyimpan kredensial ke Google Drive adalah sinyal risiko
    sekaligus kebocoran nyata di perangkat kiosk yang dipakai bergantian.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="coffeelabs_qris_bridge_prefs.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
